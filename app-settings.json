  "terms": {
    "넓적한 잎": {
      "desc": "잎이 넓고 납작해요. 손바닥만큼 넓은지 눈으로 보고, 잎을 손으로 만져 얇고 평평한지 확인해 보세요."
    },
    "길쭉한 잎": {
      "desc": "잎의 길이가 폭보다 훨씬 길어요. 잎 한쪽 끝에서 다른 끝까지 눈으로 따라가며 길이를 살펴봐요."
    },
    "바늘 잎": {
      "desc": "잎이 바늘처럼 가늘고 뾰족해요. 손으로 만져 보면 따갑고 단단하게 느껴져요."
    },
    "부채 모양": {
      "desc": "잎이 부채를 펼친 것처럼 아래는 좁고 위는 넓어요. 잎을 위에서 내려다보며 펼친 모양을 확인해요."
    },
    "손바닥 모양": {
      "desc": "잎이 손가락을 펼친 손바닥처럼 여러 갈래로 갈라져 있어요. 잎 가장자리의 갈래 수를 세어 봐요."
    },
    "깃털처럼 갈라짐": {
      "desc": "잎의 가운데 줄기 양쪽에 작은 잎이 깃털처럼 줄지어 붙어 있어요. 잎을 들어 올려 양옆을 살펴봐요."
    },
    "그물맥": {
      "desc": "잎맥이 그물처럼 얽혀 있어요. 잎을 햇빛에 비춰 보거나 돋보기로 보면 잘 보여요."
    },
    "나란히맥": {
      "desc": "잎맥이 잎의 시작부터 끝까지 나란히 뻗어 있어요. 잎을 세로로 훑어보며 줄무늬를 찾아봐요."
    },
    "부챗살맥": {
      "desc": "잎맥이 한 점에서 부채살처럼 여러 방향으로 퍼져 있어요. 잎자루 끝에서 잎 가장자리까지 눈으로 따라가요."
    },
    "굵은 나무줄기": {
      "desc": "줄기가 두껍고 단단해요. 손으로 감싸 안아 보고, 껍질이 거칠거칠한지 만져서 확인해요."
    },
    "가는 풀줄기": {
      "desc": "줄기가 가늘고 연해서 쉽게 휘어져요. 손가락으로 살살 잡아 보면 말랑하고 부드럽게 느껴져요."
    },
    "덩굴": {
      "desc": "줄기가 다른 것을 감고 길게 뻗어 자라요. 줄기 끝이 무언가를 감고 있는지 눈으로 살펴봐요."
    },
    "모름": {
      "desc": "잘 모르겠을 때 고르는 낱말이에요. 다른 친구에게 물어보거나 선생님께 여쭤보고 다시 찾아봐요."
    }
  },
  "curriculum": [],
