# ──────────────────────────────────────────────────────────────
# 학교 식물 탐사대 — 서버 환경변수 (이 파일을 복사해 .env.local 로 저장)
# ──────────────────────────────────────────────────────────────

# 모의 모드: 1 이면 국립수목원·AI(제미나이·클로드·GPT)를 호출하지 않고 samples/ 폴더의 자료로 응답
# (키 없이 화면 흐름 전체를 시연할 때, 연수 중 API 장애 시 사용)
MOCK=0

# 공유 키 허용: 1 이면 사용자가 키를 넣지 않았을 때 아래 서버 키를 대신 사용
# (강사 시연용. 참가자용 배포본에서는 0 으로 두어 각자 키를 넣게 함)
ALLOW_SHARED_KEY=0

# 공공데이터포털 "일반 인증키" (Encoding·Decoding 아무거나) — ALLOW_SHARED_KEY=1 일 때만 사용
# 사용자가 설정 화면에 자기 키를 넣으면 그 키를 먼저 쓴다
DATA_GO_KR_KEY=

# ── 강사 시연용 AI 공유 키 (ALLOW_SHARED_KEY=1 일 때만, 사용자가 AI 키를 안 넣었을 때 사용) ──
# 어느 AI를 먼저 쓸지: gemini | claude | openai (비우면 키가 있는 첫 번째)
AI_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 모델 이름 (보통 비워 두기) ──
# 제미나이: 비우면 자동 선택 (lib/server/ai/gemini.ts 의 GEMINI_MODELS 를 차례로, 은퇴·혼잡이면 다음 모델)
#          쉼표로 여러 개 가능 (예: gemini-3.5-flash,gemini-3-flash-preview)
GEMINI_MODEL=
# 클로드: 비우면 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5 나 claude-haiku-5-5 로 바꿀 수 있음
CLAUDE_MODEL=
# GPT: 비우면 자동 선택 (lib/server/ai/openai.ts 의 OPENAI_MODELS 를 차례로). 쉼표로 여러 개 가능
OPENAI_MODEL=
